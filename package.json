{
  "name": "Speekr-WordPress-Plugin",
  "version": "1.0.0",
  "description": "Hey, I'm a plugin for speakers using WordPress as a CMS.",
  "author": "Geoffrey Crofte",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "WordPress",
    "Plugin",
    "Speakers",
    "Conferences",
    "Talks"
  ],
  "homepage": "https://github.com/geoffreycrofte/speekr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoffreycrofte/speekr.git"
  },
  "bugs": {
    "url": "https://github.com/geoffreycrofte/speekr/issues"
  },
  "scripts": {
    "build":     "wp-scripts build",
    "build:dev": "wp-scripts build --mode=development",
    "start":     "wp-scripts start",
    "lint":      "wp-scripts lint-js && wp-scripts lint-style",
    "clean":     "rm -rf build"
  },
  "devDependencies": {
    "@wordpress/scripts": "^31.5.0",
    "dir-archiver": "^1.1.1"
  }
}
